# ============================================================
# AfrikLearn - Environment Variables
# Copy this file to .env.local for local development
# Copy the same values into Vercel for production
# ============================================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/afriklearn?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"

# Seeded admin and demo student accounts
SEED_ADMIN_EMAIL="diorrebero90@icloud.com"
SEED_ADMIN_PASSWORD="xhris2345"
SEED_ADMIN_NAME="Admin AfrikLearn"
SEED_ADMIN_UNIVERSITY="AfrikLearn HQ"
SEED_STUDENT_EMAIL="student@uy1.cm"
SEED_STUDENT_PASSWORD="Student@123"
SEED_STUDENT_NAME="Alina Nguetsop"
SEED_STUDENT_UNIVERSITY="University of Yaounde I"
SEED_STUDENT_FACULTY="Faculty of Science"
SEED_STUDENT_LEVEL="L2"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AfrikLearn"

# Fapshi payment gateway
FAPSHI_API_USER="your-fapshi-api-user"
FAPSHI_API_KEY="your-fapshi-api-key"
NEXT_PUBLIC_FAPSHI_BASE_URL="https://live.fapshi.com"
FAPSHI_WEBHOOK_SECRET="your-fapshi-webhook-secret"

# Cloudinary storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="AfrikLearn <noreply@afriklearn.com>"

# Premium plans
NEXT_PUBLIC_PRICE_MONTHLY="2500"
NEXT_PUBLIC_PRICE_SEMESTER="12000"
NEXT_PUBLIC_PRICE_ANNUAL="20000"
