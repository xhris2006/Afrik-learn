# ============================================================
# AfrikLearn — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Railway, Neon, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/afriklearn?schema=public"

# ── Authentication ───────────────────────────────────────────
# Strong secret key — generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AfrikLearn"

# ── Fapshi Payment Gateway ───────────────────────────────────
# Get your credentials at: https://fapshi.com/developer
FAPSHI_API_USER="your-fapshi-api-user"
FAPSHI_API_KEY="your-fapshi-api-key"
NEXT_PUBLIC_FAPSHI_BASE_URL="https://live.fapshi.com"
# Webhook secret for verifying Fapshi callbacks
FAPSHI_WEBHOOK_SECRET="your-fapshi-webhook-secret"

# ── File Storage ─────────────────────────────────────────────
# Cloudinary for document/avatar storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ── Email (Optional — for notifications) ─────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="AfrikLearn <noreply@afriklearn.com>"

# ── Premium Plans (prices in XAF) ────────────────────────────
NEXT_PUBLIC_PRICE_MONTHLY="2500"
NEXT_PUBLIC_PRICE_SEMESTER="12000"
NEXT_PUBLIC_PRICE_ANNUAL="20000"
